{
  "name": "nykolas-me",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "nykolas.me \u2014 the personal site of Nykolas Farhangi, built on the NYKO Flight Manual design system.",
  "scripts": {
    "tokens": "node scripts/tokens.mjs",
    "terrain": "python3 scripts/terrain.py",
    "dev": "npm run tokens && astro dev",
    "build": "npm run tokens && astro build",
    "preview": "astro preview",
    "deploy": "npm run build && npx wrangler@4 deploy"
  },
  "dependencies": {
    "@fontsource/big-shoulders-display": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "astro": "5.18.2"
  }
}
