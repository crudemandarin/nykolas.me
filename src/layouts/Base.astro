---
import '@fontsource/big-shoulders-display/latin-800';
import '@fontsource/ibm-plex-sans/latin-400';
import '@fontsource/ibm-plex-sans/latin-500';
import '@fontsource/ibm-plex-mono/latin-400';
import '@fontsource/ibm-plex-mono/latin-500';
import '../styles/tokens.css';
import '../styles/components.css';
import '../styles/site.css';
import StatusBar from '../components/StatusBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { person } from '../data/site';

interface Props { title?: string; description?: string; status?: 'nominal' | 'caution'; statusText?: string; home?: boolean }
const { title, description = person.bio, status = 'nominal', statusText = 'All systems nominal', home = false } = Astro.props;
const fullTitle = title ? `${title} · ${person.name}` : `${person.name} — ${person.headline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en" data-theme="dark" data-motion="auto">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="author" content={person.name} />
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#101322" />
  <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#FF4A22" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL('/og-card.png', Astro.site)} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Nykolas Farhangi — I build the systems that have to work." />
  <meta name="twitter:card" content="summary_large_image" />
  <script is:inline>
    try {
      var d = document.documentElement, t = localStorage.getItem('nk-theme'), m = localStorage.getItem('nk-motion');
      if (t === 'light' || t === 'dark') d.dataset.theme = t;
      if (m === 'idle' || m === 'armed') d.dataset.motion = m;
      else if (matchMedia('(prefers-reduced-motion: reduce)').matches) d.dataset.motion = 'idle';
    } catch (e) {}
  </script>
</head>
<body>
  <a class="skip nk-btn nk-btn--primary" href="#main">Skip to content</a>
  <div class="masthead">
    <StatusBar status={status} text={statusText} />
    <Header home={home} />
  </div>
  <main id="main"><slot /></main>
  <Footer />
  <script is:inline>
    (function () {
      var d = document.documentElement;
      function save(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }
      function sync() {
        document.querySelectorAll('[data-switch="theme"] b').forEach(function (b) { b.textContent = d.dataset.theme === 'light' ? 'Day' : 'Night'; });
        document.querySelectorAll('[data-switch="motion"] b').forEach(function (b) { b.textContent = d.dataset.motion === 'idle' ? 'Idle' : 'Armed'; });
        document.querySelectorAll('[data-motion-src]').forEach(function (img) {
          var want = d.dataset.motion === 'idle' ? img.dataset.still : img.dataset.motionSrc;
          if (img.getAttribute('src') !== want) img.setAttribute('src', want);
        });
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', d.dataset.theme === 'light' ? '#F4F5F9' : '#101322');
      }
      document.querySelectorAll('[data-switch]').forEach(function (el) {
        el.hidden = false;
        el.addEventListener('click', function () {
          if (el.dataset.switch === 'theme') { d.dataset.theme = d.dataset.theme === 'light' ? 'dark' : 'light'; save('nk-theme', d.dataset.theme); }
          else { d.dataset.motion = d.dataset.motion === 'idle' ? 'armed' : 'idle'; save('nk-motion', d.dataset.motion); }
          sync();
        });
      });
      sync();
      var clock = document.getElementById('nk-clock');
      if (clock) {
        var tick = function () { try { clock.textContent = new Date().toLocaleTimeString('en-US', { hour12: false, timeZone: 'America/Los_Angeles' }); } catch (e) {} };
        tick(); setInterval(tick, 1000); clock.parentElement.hidden = false;
      }
      document.querySelectorAll('[data-copy]').forEach(function (btn) {
        btn.hidden = false;
        btn.addEventListener('click', function () {
          if (!navigator.clipboard) return;
          navigator.clipboard.writeText(btn.dataset.copy).then(function () { btn.textContent = 'Copied'; setTimeout(function () { btn.textContent = 'Copy'; }, 1600); });
        });
      });
      var links = document.querySelectorAll('.nav a[href^="#"]');
      if ('IntersectionObserver' in window && links.length) {
        var io = new IntersectionObserver(function (es) {
          es.forEach(function (e) { if (e.isIntersecting) links.forEach(function (a) { a.setAttribute('aria-current', a.getAttribute('href') === '#' + e.target.id ? 'true' : 'false'); }); });
        }, { rootMargin: '-45% 0px -50% 0px' });
        links.forEach(function (a) { var s = document.querySelector(a.getAttribute('href')); if (s) io.observe(s); });
      }
    })();
  </script>
</body>
</html>
