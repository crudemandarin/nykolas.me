---
// Travel Log: an interactive globe of where I've lived and where I've been.
// Data: src/data/travel.ts. Engine: src/scripts/globe.ts (lazy-loaded).
import { geoDistance } from 'd3-geo';
import { places, homes, trips } from '../../data/travel';
interface Props { n: string; icon?: string }
const { n, icon } = Astro.props;

const MI = 3958.8;
const ll = (id: string) => [places[id].lon, places[id].lat] as [number, number];
const legMiles = (t: (typeof trips)[number]) => t.stops.slice(1).reduce((s, id, i) => s + geoDistance(ll(t.stops[i]), ll(id)) * MI, 0);
const miles = Math.round(trips.reduce((s, t) => s + legMiles(t), 0));
const crewTrips = trips.filter((t) => t.crew);
const crewMiles = Math.round(crewTrips.reduce((s, t) => s + legMiles(t), 0));
const countries = new Set(Object.values(places).map((p) => p.country));
const modeOf = (t: (typeof trips)[number]) => [...new Set(t.modes ?? [t.mode])].join(' + ');
const visited = new Set([...homes.map((h) => h.place), ...trips.flatMap((t) => t.stops)]);
const sorted = [...trips].sort((a, b) => b.date.localeCompare(a.date));
const route = (t: (typeof trips)[number]) => t.stops.map((s) => places[s].name).join(' → ');
const current = homes.find((h) => !h.to)?.place;
const travel = JSON.stringify({ places, homes, trips, current });
const fmt = (v: number) => v.toLocaleString('en-US');
---
<section id="travel" class="section" aria-labelledby="travel-h" data-travel-scope>
  <div class="wrap">
    <div class="nk-section-head"><span class="nk-index">{icon && <Fragment set:html={icon} />}{n}</span><h2 id="travel-h" class="display-lg">Travel Log</h2><span class="nk-label nk-meta">{visited.size} sites · {trips.length} sorties</span></div>
    <hr class="nk-seam" />
    <div class="section-body">
      <article class="nk-plate nk-reg tl">
        <div class="nk-plate-head"><span class="nk-label">TL-01 · Ground track</span><span class="nk-label">Orthographic · Natural Earth 1:110m</span></div>
        <div class="tl-body">
          <div class="tg" data-travel={travel}>
            <canvas tabindex="0" role="img" aria-label="Interactive globe showing the places I've lived as pins and my trips as ribbons between them. Drag to rotate; click, then scroll to zoom. Arrow keys rotate, plus and minus zoom, R resets. The same information is listed beside the globe."></canvas>
            <div class="tg-tip nk-label-sm" hidden></div>
            <div class="tg-top">
              <span class="nk-label-sm">Fig. 3 — Ground track</span>
              <span class="nk-label-sm" data-tg="center"></span>
            </div>
            <div class="tg-hud">
              <span class="nk-label-sm tg-hint"><span class="when-idle"><span class="fine-ptr">Drag to rotate · Click, then scroll to zoom</span><span class="coarse-ptr">Drag to rotate · Pinch to zoom</span></span><span class="when-engaged">Engaged · Esc to release · R to reset</span></span>
              <span class="tg-ctrls">
                <button class="switch" type="button" data-tg="out" aria-label="Zoom out">−</button>
                <button class="switch" type="button" data-tg="in" aria-label="Zoom in">+</button>
                <button class="switch" type="button" data-tg="reset">Reset</button>
              </span>
            </div>
            <p class="tg-fallback nk-label-sm">Globe needs JavaScript · The log beside it lists the same routes</p>
          </div>

          <div class="tl-side">
            <dl class="tl-readouts">
              <div><dt class="nk-label-sm">Distance logged</dt><dd class="readout">{fmt(miles)}<small> mi</small></dd></div>
              <div><dt class="nk-label-sm">With Powder</dt><dd class="readout">{fmt(crewMiles)}<small> mi</small></dd></div>
              <div><dt class="nk-label-sm">Countries</dt><dd class="readout">{countries.size}</dd></div>
            </dl>

            <div class="tl-legend" role="group" aria-label="Show on globe">
              <button type="button" class="tl-key" data-layer="homes" aria-pressed="true"><i class="k-home"></i>Lived<b>{new Set(homes.map((h) => h.place)).size}</b></button>
              <button type="button" class="tl-key" data-layer="solo" aria-pressed="true"><i class="k-solo"></i>Trips<b>{trips.length - crewTrips.length}</b></button>
              <button type="button" class="tl-key" data-layer="crew" aria-pressed="true"><i class="k-crew"></i>With Powder<b>{crewTrips.length}</b></button>
            </div>
            <p class="nk-label-sm tl-modes"><span><i class="m-move"></i>Moved</span><span><i class="m-air"></i>Air</span><span><i class="m-road"></i>Road</span><span><i class="m-rail"></i>Rail</span><span><i class="m-sea"></i>Sea</span></p>

            <div class="tl-log">
              <h3 class="nk-label">Residences</h3>
              <ol class="tl-list">
                {[...homes].reverse().map((h) => (
                  <li><button type="button" class="tl-row home" data-place={h.place}>
                    <span class="data">{h.from}–{h.to ?? 'now'}</span>
                    <span class="t"><b>{places[h.place].name}, {places[h.place].region}</b>{h.note && <span class="nk-label-sm">{h.note}</span>}</span>
                    {!h.to && <span class="nk-lamp nk-lamp--nominal">Base</span>}
                  </button></li>
                ))}
              </ol>
              <h3 class="nk-label">Sorties</h3>
              <ol class="tl-list">
                {sorted.map((t) => (
                  <li><button type="button" class={`tl-row${t.crew ? ' crew' : ''}`} data-trip={t.id} aria-pressed="false">
                    <span class="data">{t.date}</span>
                    <span class="t"><b>{t.title}</b><span class="nk-label-sm">{route(t)} · {modeOf(t)}</span></span>
                    {t.crew && <span class="nk-tag tl-crew" title="Powder came along">CR-01</span>}
                  </button></li>
                ))}
              </ol>
            </div>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

<script>
  const els = document.querySelectorAll<HTMLElement>('.tg[data-travel]');
  if (els.length) {
    const load = () => import('../../scripts/globe').then((m) => els.forEach((el) => m.mount(el)));
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { io.disconnect(); load(); } }, { rootMargin: '600px' });
      els.forEach((el) => io.observe(el));
    } else load();
  }
</script>

<style>
  .tl-body { display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(300px, 1fr); }
  .tg { position: relative; min-height: 600px; background: var(--surface-200); border-right: var(--stroke-hair) solid var(--line); overflow: hidden; }
  .tg canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; cursor: grab; touch-action: pan-y; opacity: 0; transition: opacity 400ms linear; }
  .tg canvas:active { cursor: grabbing; }
  .tg.engaged canvas { touch-action: none; }
  .tg canvas:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: -2px; }
  .tg.ready canvas { opacity: 1; }
  .tg-fallback { position: absolute; inset: 0; display: grid; place-items: center; padding: var(--space-8); text-align: center; }
  .tg.ready .tg-fallback { display: none; }
  .tg-top, .tg-hud { position: absolute; left: 0; right: 0; display: flex; justify-content: space-between; align-items: center; gap: var(--space-4); padding: var(--space-3) var(--space-4); pointer-events: none; }
  .tg-top { top: 0; } .tg-hud { bottom: 0; }
  .tg-hud > * { pointer-events: auto; }
  .tg-ctrls { display: flex; gap: var(--space-2); }
  .tg-ctrls .switch { background: var(--surface-200); }
  .tg:not(.ready) .tg-hud, .tg:not(.ready) .tg-top { display: none; }
  .tg .when-engaged { display: none; }
  .tg.engaged .when-engaged { display: inline; }
  .tg.engaged .when-idle { display: none; }
  .tg-tip { position: absolute; left: 0; top: 0; z-index: 2; display: grid; gap: 2px; padding: var(--space-2) var(--space-3); background: var(--surface-100); border: var(--stroke-hair) solid var(--line-strong); pointer-events: none; white-space: nowrap; }
  .tg-tip[hidden] { display: none; }
  .tg-tip :global(b) { color: var(--ink); font-weight: 500; }
  .tg-tip :global(.hot) { color: var(--ember-text); }

  .tl-side { display: grid; align-content: start; gap: var(--space-6); padding: var(--space-6); min-width: 0; }
  .tl-readouts { display: grid; grid-template-columns: 1.3fr 1.3fr 1fr; gap: var(--space-4); margin: 0; }
  .tl-readouts div { display: grid; gap: var(--space-1); padding-bottom: var(--space-3); border-bottom: var(--stroke-hair) solid var(--line); }
  .tl-readouts dd { margin: 0; }
  .tl-readouts small { font-size: 14px; color: var(--ink-subtle); }

  .tl-legend { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .tl-key { display: inline-flex; align-items: center; gap: var(--space-2); height: 32px; padding: 0 var(--space-3); background: transparent; border: var(--stroke-hair) solid var(--control); border-radius: var(--radius-1); color: var(--ink); font-family: var(--font-mono); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; cursor: pointer; }
  .tl-key:hover { background: var(--surface-300); }
  .tl-key b { font-weight: 500; color: var(--ink-subtle); }
  .tl-key[aria-pressed="false"] { color: var(--ink-subtle); border-color: var(--line); text-decoration: line-through; }
  .tl-key[aria-pressed="false"] i { opacity: .35; }
  .tl-key i, .tl-modes i { display: inline-block; flex: none; }
  .k-home { width: 9px; height: 9px; background: var(--ember); transform: rotate(45deg); }
  .k-solo { width: 9px; height: 9px; border: 2px solid var(--signal); border-radius: 50%; }
  .k-crew { width: 9px; height: 9px; border: 2px solid var(--amber); }
  .tl-modes { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4); margin-top: calc(-1 * var(--space-3)); }
  .tl-modes span { display: inline-flex; align-items: center; gap: var(--space-2); }
  .m-air { width: 22px; height: 2px; background: var(--ink-muted); }
  .m-move { width: 22px; height: 2px; background: repeating-linear-gradient(90deg, var(--ember) 0 2px, transparent 2px 6px); }
  .m-sea { width: 22px; height: 2px; background: repeating-linear-gradient(90deg, var(--ink-muted) 0 2px, transparent 2px 5px); }
  .m-rail { width: 22px; height: 2px; background: repeating-linear-gradient(90deg, var(--ink-muted) 0 10px, transparent 10px 13px, var(--ink-muted) 13px 15px, transparent 15px 18px); }
  .m-road { width: 22px; height: 2px; background: repeating-linear-gradient(90deg, var(--ink-muted) 0 4px, transparent 4px 8px); }

  .tl-log { display: grid; gap: var(--space-3); max-height: 360px; overflow-y: auto; scrollbar-width: thin; }
  .tl-log h3 { margin-top: var(--space-2); }
  .tl-list { list-style: none; margin: 0; padding: 0; border-top: var(--stroke-hair) solid var(--line); }
  .tl-row { display: grid; grid-template-columns: 84px minmax(0, 1fr) auto; gap: var(--space-3); align-items: center; width: 100%; padding: var(--space-3) var(--space-2); background: transparent; border: 0; border-bottom: var(--stroke-hair) solid var(--line); border-left: var(--stroke-lead) solid transparent; color: var(--ink); text-align: left; cursor: pointer; font: inherit; }
  .tl-row:hover { background: var(--surface-300); }
  .tl-row[aria-pressed="true"] { background: var(--surface-300); border-left-color: var(--signal); }
  .tl-row.crew[aria-pressed="true"] { border-left-color: var(--amber); }
  .tl-row .data { color: var(--ink-muted); }
  .tl-row .t { display: grid; gap: 2px; min-width: 0; }
  .tl-row .t b { font-weight: 500; font-size: 15px; }
  .tl-row .t .nk-label-sm { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .tl-crew { color: var(--amber); border-color: var(--amber); }
  :global([data-theme="light"]) .tl-crew { color: var(--caution); border-color: var(--caution); }
  :global([data-theme="light"]) .k-crew { border-color: var(--caution); }
  :global([data-theme="light"]) .tl-row.crew[aria-pressed="true"] { border-left-color: var(--caution); }
  @media (max-width: 640px) {
    .tg-hint, .tg-top > :first-child, .tl .nk-plate-head > :last-child { display: none; }
    .tl-side { padding: var(--space-4); }
    .tl-row { grid-template-columns: 72px minmax(0, 1fr) auto; }
  }

  @media (max-width: 1000px) {
    .tl-body { grid-template-columns: 1fr; }
    .tg { min-height: 0; aspect-ratio: 1; border-right: 0; border-bottom: var(--stroke-hair) solid var(--line); }
    .tl-log { max-height: none; }
  }
  .coarse-ptr { display: none; }
  @media (pointer: coarse) { .fine-ptr { display: none; } .coarse-ptr { display: inline; } }
</style>
