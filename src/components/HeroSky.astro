---
// The hero's night sky and the Flight Mode easter egg. Logic lives in
// src/scripts/hero-sky.ts (scene) and src/scripts/flight.ts (game).
---
<canvas class="hero-sky" aria-hidden="true"></canvas>
<style>
  .hero-sky { position: absolute; inset: 0; width: 100%; height: 100%; display: block; pointer-events: none; z-index: 0; }
</style>
<script>
  import { initHeroSky } from '../scripts/hero-sky';
  initHeroSky();
</script>
