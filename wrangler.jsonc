{
  // Cloudflare Workers static-assets deploy: `npm run deploy`
  "name": "nykolas-me",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",   // /flight-manual -> flight-manual.html
    "not_found_handling": "404-page"          // serves dist/404.html with a 404 status
  }
}
